# Server-only runtime secrets. Replace all placeholders before starting.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/veritas
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
# Bootstrap only: remove ADMIN_PASSWORD after first admin login.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET

# Server-only runtime non-secrets
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
NODE_ENV=production
# Container defaults; do not override its listener with a loopback address.
HOSTNAME=0.0.0.0
PORT=3000

# No application build-time variables or NEXT_PUBLIC_* variables are required.
# NEXT_PUBLIC_APP_URL found in older local files is unused and can be removed.
